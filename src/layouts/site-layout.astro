---
// The frame of every page: a link to skip to the content, the header, the content in main and the
// footer. main clips what runs past the sides of the screen (src/styles/global.css): anything
// that may, as a large faded word, goes inside it.
import BackToTop from "../components/back-to-top.astro";
import SiteFooter from "../components/site-footer.astro";
import SiteHeader from "../components/site-header.astro";
import { type Lang, type PageId, ui } from "../lib/i18n";
import BaseLayout from "./base-layout.astro";

interface Props {
  lang: Lang;
  /** The page in the table of routes, which has its twin in the other language. */
  page?: PageId;
  title: string;
  description: string;
  noindex?: boolean;
}

const props = Astro.props;
const { lang, page } = props;
---

<BaseLayout {...props}>
  <a class="skip-link visually-hidden" href="#content">
    {ui(lang).skipLink}
  </a>
  <SiteHeader lang={lang} page={page} />
  <main id="content" tabindex="-1">
    <slot />
  </main>
  <SiteFooter lang={lang} page={page} />
  {page && <BackToTop lang={lang} />}
</BaseLayout>

<script>
  // The grid turns red under a mouse, and never when the visitor asked to reduce motion. A zone
  // reaches above its own box by --grid-overrun (src/styles/global.css), and the red is placed
  // from the top of what is drawn.
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const zones = [
    ...document.querySelectorAll<HTMLElement>(".grid-zone, .grid-band"),
  ].map((element) => ({
    element,
    overrun:
      parseFloat(
        getComputedStyle(element).getPropertyValue("--grid-overrun"),
      ) || 0,
  }));

  document.addEventListener("pointermove", (event) => {
    if (event.pointerType !== "mouse" || reducedMotion.matches) return;
    for (const { element, overrun } of zones) {
      const box = element.getBoundingClientRect();
      const top = box.top - overrun;
      const isInside = event.clientY >= top && event.clientY <= box.bottom;
      element.classList.toggle("is-lit", isInside);
      if (isInside) {
        element.style.setProperty("--mx", `${event.clientX - box.left}px`);
        element.style.setProperty("--my", `${event.clientY - top}px`);
      }
    }
  });

  document.documentElement.addEventListener("mouseleave", () => {
    for (const { element } of zones) element.classList.remove("is-lit");
  });
</script>

<style>
  .skip-link:focus {
    position: fixed;
    z-index: 10;
    top: var(--space-2);
    left: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--color-background);
  }

  main:focus {
    outline: none;
  }
</style>
