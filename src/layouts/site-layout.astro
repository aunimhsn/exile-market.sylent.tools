---
// The frame of every page: a link to skip to the content, the header, the content in main and the
// footer. main clips what runs past the sides of the screen (src/styles/global.css): anything
// that may, as a large faded word, goes inside it.
import BackToTop from "../components/back-to-top.astro";
import SiteFooter from "../components/site-footer.astro";
import SiteHeader from "../components/site-header.astro";
import { type Lang, type PageId, ui } from "../lib/i18n";
import BaseLayout from "./base-layout.astro";

interface Props {
  lang: Lang;
  /** The page in the table of routes, which has its twin in the other language. */
  page?: PageId;
  title: string;
  description: string;
  noindex?: boolean;
}

const props = Astro.props;
const { lang, page } = props;
---

<BaseLayout {...props}>
  <a class="skip-link visually-hidden" href="#content">
    {ui(lang).skipLink}
  </a>
  <SiteHeader lang={lang} page={page} />
  <main id="content" tabindex="-1">
    <slot />
  </main>
  <SiteFooter lang={lang} page={page} />
  {page && <BackToTop lang={lang} />}
</BaseLayout>

<style>
  .skip-link:focus {
    position: fixed;
    z-index: 10;
    top: var(--space-2);
    left: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--color-background);
  }

  main:focus {
    outline: none;
  }
</style>
