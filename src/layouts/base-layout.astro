---
// The document shared by every page: language, metadata, icons, preview card and base styles.
import { Font, getImage } from "astro:assets";
import socialCard from "../assets/brand/social-card.png";
import {
  defaultLang,
  type Lang,
  languages,
  otherLang,
  type PageId,
  routes,
  ui,
} from "../lib/i18n";
import { href } from "../lib/url";
import "../styles/global.css";

interface Props {
  lang: Lang;
  /** The page in the table of routes, which has its twin in the other language. */
  page?: PageId | undefined;
  title: string;
  description: string;
  /** A page that search engines must not index, as the not-found page. */
  noindex?: boolean;
}

const { lang, page, title, description, noindex = false } = Astro.props;
const texts = ui(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
// Under a base path, the site is the preview at its github.io address, which search engines
// must not index beside the former site or the domain.
const isPreview = import.meta.env.BASE_URL !== "/";
// The card that LinkedIn, Facebook and the messaging apps show for a link to any page: its title,
// its description and one image of 1200 × 630 px (docs/branding.md, Brand assets). The networks
// want an absolute URL and read JPEG everywhere, WebP not always; the name of the file carries a
// hash of its content, so that a new image gets a new URL instead of their cached copy. X reads
// twitter:card to show the large card, and the rest from the Open Graph tags.
const card = await getImage({
  src: socialCard,
  format: "jpeg",
  width: 1200,
  height: 630,
  quality: 85,
});
const cardUrl = new URL(card.src, Astro.site);
// The hreflang links tell search engines that the page exists in the other language, and which one
// to show to a visitor who speaks neither (x-default).
const urlIn = (language: Lang) =>
  page && new URL(href(routes[page][language]), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Font cssVariable="--font-manrope" preload />
    <Font cssVariable="--font-cormorant" />
    <!--
      The icon of the site (npm run brand:images, from src/assets/brand/icon.svg): SVG for the
      browsers that read it, ICO (16, 32, 48 px) for the others and for the search engines, which
      look for /favicon.ico, and a PNG of 180 px for a shortcut on an iPhone.
    -->
    <link rel="icon" href={href("/favicon.ico")} sizes="32x32" />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href("/apple-touch-icon.png")} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {page &&
      languages.map((language) => (
        <link rel="alternate" hreflang={language} href={urlIn(language)} />
      ))}
    {page && (
      <link rel="alternate" hreflang="x-default" href={urlIn(defaultLang)} />
    )}
    {(isPreview || noindex) && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={texts.site.name} />
    <meta property="og:locale" content={texts.site.ogLocale} />
    {page && (
      <meta
        property="og:locale:alternate"
        content={ui(otherLang(lang)).site.ogLocale}
      />
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={cardUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(card.attributes.width)} />
    <meta property="og:image:height" content={String(card.attributes.height)} />
    <meta property="og:image:alt" content={texts.site.cardAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
