---
// The not-found page, written as 404.html, which GitHub Pages serves for every path without a
// page, whatever its language: it holds both, without JavaScript. No canonical link and noindex.
// Its texts are in src/content/<lang>/not-found.json.
import en from "../content/en/not-found.json";
import fr from "../content/fr/not-found.json";
import SiteLayout from "../layouts/site-layout.astro";
import { routes } from "../lib/i18n";
import { href } from "../lib/url";
---

<SiteLayout lang="en" title={en.title} description={en.description} noindex>
  <div class="wrap">
    <h1>{en.heading}</h1>
    <p>{en.lead}</p>
    <a href={href(routes.home.en)}>{en.home}</a>
    <h2 lang="fr">{fr.heading}</h2>
    <p lang="fr">{fr.lead}</p>
    <a lang="fr" href={href(routes.home.fr)}>
      {fr.home}
    </a>
  </div>
</SiteLayout>

<style>
  .wrap {
    padding-block: var(--space-16);
  }

  h1,
  h2 {
    font-size: var(--size-title);
  }

  h2 {
    margin-top: var(--space-12);
  }
</style>
