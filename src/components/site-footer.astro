---
// The footer of every page: the copyright and the link to the legal notice.
import { type Lang, routes, ui } from "../lib/i18n";
import { href } from "../lib/url";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const texts = ui(lang);
const copyright = texts.footer.copyright.replace(
  "{year}",
  String(new Date().getFullYear()),
);
---

<footer class="site-footer">
  <div class="wrap">
    <p>{copyright}</p>
    <a href={href(routes.legal[lang])}>{texts.footer.legal}</a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-16);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-weak);
    font-size: var(--size-label);
  }

  .wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-6);
  }

  p {
    margin: 0;
  }

  a {
    color: inherit;
  }
</style>
