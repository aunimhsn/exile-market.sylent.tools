---
// The header of every page: the logo, which leads to the home page, the main navigation, whose
// links are listed in src/i18n/<lang>.json, and the link to the same page in the other language,
// without any automatic redirect. The not-found page holds both languages and has no such link.
// The link of the current page is marked with aria-current.
import logo from "../assets/brand/logo.svg?raw";
import { type Lang, otherLang, type PageId, routes, ui } from "../lib/i18n";
import { currentOf, href } from "../lib/url";

interface Props {
  lang: Lang;
  page?: PageId | undefined;
}

const { lang, page } = Astro.props;
const texts = ui(lang);
const other = otherLang(lang);
const links = [{ path: routes.home[lang], label: texts.nav.home }];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap">
    <a class="logo" href={href(routes.home[lang])} aria-label={texts.site.name}>
      <Fragment set:html={logo} />
    </a>
    <nav aria-label={texts.nav.label}>
      <ul>
        {links.map(({ path, label }) => (
          <li>
            <a href={href(path)} aria-current={currentOf(path, current)}>
              {label}
            </a>
          </li>
        ))}
        {page && (
          <li>
            <a href={href(routes[page][other])} hreflang={other} lang={other}>
              {ui(other).languageName}
            </a>
          </li>
        )}
      </ul>
    </nav>
  </div>
</header>

<style>
  .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .logo {
    color: var(--color-text);
  }

  .logo :global(svg) {
    width: auto;
    height: 32px;
  }

  ul {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--color-text);
    text-decoration: none;
  }

  nav a[aria-current] {
    text-decoration: underline;
  }
</style>
