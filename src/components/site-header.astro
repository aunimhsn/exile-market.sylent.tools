---
// The header of every page: the emblem and the name, which lead to the home page, and the flag of
// the other language, which links to the same page in that language, without any automatic
// redirect. The not-found page holds both languages and has no such link.
import emblem from "../assets/brand/emblem.svg?raw";
import flagEn from "../assets/flags/en.svg?raw";
import flagFr from "../assets/flags/fr.svg?raw";
import { type Lang, otherLang, type PageId, routes, ui } from "../lib/i18n";
import { href } from "../lib/url";

interface Props {
  lang: Lang;
  page?: PageId | undefined;
}

const { lang, page } = Astro.props;
const other = otherLang(lang);
const otherName = ui(other).languageName;
// Drawn in SVG: an emoji flag shows as two letters on Windows.
const flags: Record<Lang, string> = { en: flagEn, fr: flagFr };
---

<header class="site-header">
  <div class="wrap">
    <a class="site-brand" href={href(routes.home[lang])}>
      <span aria-hidden="true">
        <Fragment set:html={emblem} />
      </span>
      <span class="site-brand-text">{ui(lang).site.name}</span>
    </a>
    {page && (
      <a
        href={href(routes[page][other])}
        hreflang={other}
        class="site-language"
        lang={other}
        aria-label={otherName}
        title={otherName}
      >
        <Fragment set:html={flags[other]} />
      </a>
    )}
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 1;
  }

  .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--height-header);
  }

  .site-brand :global(svg) {
    width: 26px;
    height: 26px;
  }

  /* Under the pointer, the name grows a little instead of turning red, and the emblem doesn't
     move. */
  .site-brand:hover,
  .site-brand:focus-visible {
    color: var(--color-text);
  }

  .site-brand-text {
    display: inline-block;
    transform-origin: left center;
    transition: transform 0.2s;
  }

  .site-brand:hover .site-brand-text,
  .site-brand:focus-visible .site-brand-text {
    transform: scale(1.06);
  }

  .site-language {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -8px;
  }

  .site-language :global(svg) {
    width: 28px;
    height: 19px;
    box-shadow: 0 0 0 1px #ffffff33;
    transition: transform 0.15s;
  }

  .site-language:hover :global(svg) {
    transform: scale(1.1);
  }
</style>
