---
// The home page, in the language of its route (src/pages/index.astro, src/pages/fr/index.astro).
// Its texts are in src/content/<lang>/home.json; a text may hold a link or a key, hence set:html,
// on texts that come only from those files.
import en from "../content/en/home.json";
import fr from "../content/fr/home.json";
import SiteLayout from "../layouts/site-layout.astro";
import { issues } from "../lib/application";
import type { Lang } from "../lib/i18n";
import DownloadArea from "./download-area.astro";
import FeatureDeck from "./feature-deck.astro";
import HeroVideo from "./hero-video.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const pages: Record<Lang, typeof en> = { en, fr };
const page = pages[lang];
---

<SiteLayout
  lang={lang}
  page="home"
  title={page.title}
  description={page.description}
>
  <div class="grid-zone">
    <div class="wrap">
      <section class="hero">
        <h1>
          {page.headline.start}{" "}
          <span class="hero-price">{page.headline.end}</span>
        </h1>
        <p class="hero-subtitle">{page.subtitle}</p>
        <DownloadArea texts={page.download} />
        <HeroVideo lang={lang} texts={page.video} />
      </section>
    </div>
  </div>

  <script is:inline>
    // The large sentences leave their place before the first paint, hence an inline script placed
    // before them. Without JavaScript or with reduced motion, they never move. The second script,
    // after the last sentence, brings them in.
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("statements-wait");
    }
  </script>

  <section class="band is-alt">
    <div class="wrap">
      <p class="band-statement">
        <span>{page.afterDownload[0]}</span>{" "}
        <span>{page.afterDownload[1]}</span>
      </p>
    </div>
  </section>

  <section class="band grid-band">
    <div class="wrap">
      <h2 class="visually-hidden">{page.features.heading}</h2>
      <FeatureDeck lang={lang} cards={page.features.cards} />
    </div>
  </section>

  <section class="band is-alt">
    <div class="wrap trust-grid">
      <div>
        <h2 class="band-heading">{page.computer.heading}</h2>
        <ul class="trust-list">
          {page.computer.items.map((item) => (
            <li set:html={item} />
          ))}
        </ul>
      </div>
      <div>
        <h2 class="band-heading">{page.questions.heading}</h2>
        <div class="questions-list">
          {page.questions.items.map(({ id, question, answers }) => (
            <div class="question" id={id}>
              <h3>{question}</h3>
              <div class:list={{ "risk-text": id === "risk" }}>
                {answers.map((answer) => (
                  <p set:html={answer} />
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2 class="visually-hidden">{page.help.heading}</h2>
      <p class="band-statement is-help">
        <span>{page.help.question}</span>{" "}
        <span>
          <a href={issues}>{page.help.link}</a>
          {page.help.rest}
        </span>
      </p>
    </div>
  </section>

  <script is:inline>
    // Each large sentence comes in once, when 60 % of it is on the screen. Inline and right after
    // them, so that no script to download, now or later, can keep them out of the screen.
    if (document.documentElement.classList.contains("statements-wait")) {
      const watch = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-in");
            watch.unobserve(entry.target);
          }
        },
        { threshold: 0.6 },
      );
      document
        .querySelectorAll(".band-statement")
        .forEach((statement) => watch.observe(statement));
    }
  </script>
</SiteLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-3) 0 var(--band-padding);
    text-align: center;
  }

  .hero-price {
    color: var(--color-accent);
  }

  .hero-subtitle {
    max-width: 100%;
    margin-top: var(--space-2);
    color: var(--color-text-weak);
    font-family: var(--font-subtitle);
    font-size: calc(var(--size-subtitle) * var(--subtitle-scale));
    font-style: var(--subtitle-style);
    font-weight: var(--subtitle-weight);
    line-height: 28px;
    text-shadow: var(--shadow-on-grid);
    text-wrap: balance;
  }

  .band {
    padding-block: var(--band-padding);
    background: var(--color-background);
  }

  .band.is-alt {
    background: var(--color-band);
  }

  /* The only thing a visitor must not miss after the download, and the help: no title, no steps. */
  .band-statement {
    color: var(--color-text);
    font-family: var(--font-title);
    font-size: var(--size-display);
    font-weight: var(--weight-title);
    letter-spacing: var(--tracking-title);
    line-height: var(--line-title);
    text-align: center;
    text-wrap: balance;
  }

  .band-statement > span {
    display: block;
    transition: transform var(--entrance-time) var(--ease-draw);
  }

  .band-statement > span + span {
    color: var(--color-accent);
    transition-delay: var(--entrance-gap);
  }

  /* Out of the screen until they come in: main clips them. Never on paper, where a sentence not
     seen yet would be missing. */
  @media screen {
    :global(.statements-wait) .band-statement:not(.is-in) > span {
      transform: translateX(100vw);
    }

    :global(.statements-wait) .band-statement:not(.is-in) > span + span {
      transform: translateX(-100vw);
    }
  }

  /* The help: the question large and red, the answer small. Its link has no underline: its white
     and its weight tell it from the text around it. */
  .band-statement.is-help > span + span {
    margin-top: var(--space-3);
    color: var(--color-text-faint);
    font-family: var(--font-text);
    font-size: var(--size-subtitle);
    font-weight: var(--weight-text);
    letter-spacing: 0;
    line-height: var(--line-body);
  }

  .band-statement.is-help > span:first-child {
    color: var(--color-accent);
  }

  .is-help a {
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
  }

  .is-help a:hover,
  .is-help a:focus-visible {
    color: var(--color-accent);
  }

  .trust-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-12);
    align-items: start;
  }

  .band-heading {
    margin-bottom: var(--heading-gap);
  }

  .trust-list {
    display: grid;
    gap: var(--space-4);
  }

  .trust-list li {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .questions-list {
    display: grid;
    gap: var(--space-8);
    max-width: var(--width-text);
  }

  .question {
    scroll-margin-top: var(--space-4);
  }

  /* In blood red and larger than the small red links, so that a question reads as a title. */
  .question h3 {
    color: var(--color-accent);
    font-size: var(--size-subtitle);
    font-weight: 700;
  }

  .question p {
    margin-top: var(--space-2);
  }

  /* A grey line, the grey of the Linux button: the red stays for the questions. */
  .risk-text {
    margin-top: var(--space-2);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-button-line);
  }

  .risk-text p + p {
    margin-top: var(--space-3);
  }

  /* Centered like the first screen; on a phone, the titles stay on the left. */
  @media (width >= 721px) {
    .band-heading {
      text-align: center;
    }
  }

  @media (width <= 720px) {
    .hero {
      align-items: stretch;
      text-align: left;
    }

    h1 {
      text-wrap: pretty;
    }

    .hero-subtitle {
      max-width: none;
      text-wrap: pretty;
    }

    .band-statement {
      text-align: left;
      text-wrap: pretty;
    }

    .trust-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
