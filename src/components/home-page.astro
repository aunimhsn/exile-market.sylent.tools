---
// The home page, in the language of its route (src/pages/index.astro, src/pages/fr/index.astro).
// Its texts are in src/content/<lang>/home.json.
import en from "../content/en/home.json";
import fr from "../content/fr/home.json";
import SiteLayout from "../layouts/site-layout.astro";
import type { Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const pages: Record<Lang, typeof en> = { en, fr };
const page = pages[lang];
---

<SiteLayout
  lang={lang}
  page="home"
  title={page.title}
  description={page.description}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <h1 id="hero-title">{page.heading}</h1>
      <p class="lead">{page.lead}</p>
    </div>
  </section>
</SiteLayout>

<style>
  .hero {
    padding-block: var(--space-16);
  }

  h1 {
    margin: 0;
    font-size: var(--size-display);
  }

  .lead {
    max-width: var(--width-text);
    margin: var(--space-6) 0 0;
    color: var(--color-text-weak);
  }
</style>
