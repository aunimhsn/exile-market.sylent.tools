---
// The legal notice, in the language of its route (src/pages/legal.astro,
// src/pages/fr/mentions-legales.astro). Its texts are in src/content/<lang>/legal.json; a line
// may hold a link, hence set:html, on texts that come only from those files.
import en from "../content/en/legal.json";
import fr from "../content/fr/legal.json";
import SiteLayout from "../layouts/site-layout.astro";
import { type Lang, routes } from "../lib/i18n";
import { href } from "../lib/url";
import OutlineButton from "./outline-button.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const pages: Record<Lang, typeof en> = { en, fr };
const page = pages[lang];
---

<SiteLayout
  lang={lang}
  page="legal"
  title={page.title}
  description={page.description}
>
  <div class="grid-zone is-short">
    <div class="wrap legal-head">
      <h1>{page.heading}</h1>
    </div>
  </div>
  <div class="legal-body">
    <div class="wrap">
      <div class="legal">
        {page.sections.map(({ heading, lines }) => (
          <section>
            <h2>{heading}</h2>
            {lines.map((line) => (
              <p set:html={line} />
            ))}
          </section>
        ))}
        <div class="legal-back">
          <OutlineButton href={href(routes.home[lang])}>
            {page.back}
          </OutlineButton>
        </div>
      </div>
    </div>
  </div>
</SiteLayout>

<style>
  .legal-head {
    padding-block: var(--space-16);
  }

  h1 {
    font-size: var(--size-title);
    text-transform: uppercase;
  }

  .legal-body {
    padding-bottom: var(--band-padding);
    background: var(--color-background);
  }

  .legal {
    max-width: var(--width-text);
    margin-inline: auto;
  }

  section + section {
    margin-top: var(--space-8);
  }

  /* Written like the questions of the home page. */
  h2 {
    margin-bottom: var(--space-2);
    color: var(--color-accent);
    font-family: var(--font-text);
    font-size: var(--size-subtitle);
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
  }

  p + p {
    margin-top: var(--space-1);
  }

  .legal-back {
    margin-top: var(--space-8);
  }

  @media (width >= 721px) {
    h1 {
      text-align: center;
    }
  }
</style>
