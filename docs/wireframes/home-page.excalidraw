   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "– It watches the clipboard while it runs and\nkeeps only what looks like a Path of Exile 2\nitem.",
   "originalText": "– It watches the clipboard while it runs and\nkeeps only what looks like a Path of Exile 2\nitem.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-61",
   "type": "text",
   "x": 20,
   "y": 1985.5,
   "width": 346.5,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
