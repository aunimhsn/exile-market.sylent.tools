   "width": 299.20000000000005,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-82"
   ],
   "frameId": "v4-frame-4",
   "roundness": null,
   "seed": 1368426742,
   "version": 1,
   "versionNonce": 538981927,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
