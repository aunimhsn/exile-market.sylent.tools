  {
   "id": "v4-text-68",
   "type": "text",
   "x": 20,
   "y": 2178.0,
   "width": 123.20000000000002,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-67"
   ],
   "frameId": "v4-frame-4",
   "roundness": null,
   "seed": 588093311,
   "version": 1,
   "versionNonce": 1849076401,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "1. Is it free?",
   "originalText": "1. Is it free?",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-69",
   "type": "text",
   "x": 20,
   "y": 2203.0,
   "width": 338.8,
   "height": 70.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-67"
   ],
   "frameId": "v4-frame-4",
   "roundness": null,
   "seed": 1195809358,
   "version": 1,
   "versionNonce": 1783684942,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "Yes, and it asks for no account. Its code is\nopen, and each release is built in public by\nGitHub Actions, with the checksums of each\nfile.",
   "originalText": "Yes, and it asks for no account. Its code is\nopen, and each release is built in public by\nGitHub Actions, with the checksums of each\nfile.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-71",
   "type": "text",
   "x": 20,
   "y": 2289.0,
   "width": 299.20000000000005,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-70"
   ],
   "frameId": "v4-frame-4",
   "roundness": null,
   "seed": 1540910401,
   "version": 1,
   "versionNonce": 1633982922,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "2. Why does Windows show an alert?",
   "originalText": "2. Why does Windows show an alert?",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-72",
   "type": "text",
   "x": 20,
   "y": 2314.0,
   "width": 331.1,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-70"
   ],
   "frameId": "v4-frame-4",
   "roundness": null,
   "seed": 991070208,
   "version": 1,
   "versionNonce": 648200382,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "It isn't signed for now. [How to go through\nthe alert: written after the Windows test.]",
   "originalText": "It isn't signed for now. [How to go through\nthe alert: written after the Windows test.]",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-74",
   "type": "text",
   "x": 20,
   "y": 2365.0,
   "width": 255.20000000000002,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-73"
   ],
   "frameId": "v4-frame-4",
   "roundness": null,
   "seed": 356416555,
   "version": 1,
   "versionNonce": 756849393,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "3. Can my account be at risk?",
   "originalText": "3. Can my account be at risk?",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-75",
   "type": "text",
   "x": 20,
   "y": 2390.0,
   "width": 346.5,
   "height": 122.5,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-73"
   ],
   "frameId": "v4-frame-4",
   "roundness": null,
   "seed": 649821630,
   "version": 1,
   "versionNonce": 996247159,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "Exile Market looks up offers on the official\ntrade site through an interface Grinding Gear\nGames doesn't document. Their developer\ndocumentation says that working out such an\ninterface goes against their terms of use\n(section 7i), and those terms allow them to\nclose an account without notice.",
   "originalText": "Exile Market looks up offers on the official\ntrade site through an interface Grinding Gear\nGames doesn't document. Their developer\ndocumentation says that working out such an\ninterface goes against their terms of use\n(section 7i), and those terms allow them to\nclose an account without notice.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-76",
   "type": "text",
   "x": 20,
   "y": 2518.5,
   "width": 346.5,
   "height": 105.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-73"
   ],
   "frameId": "v4-frame-4",
   "roundness": null,
   "seed": 1002170859,
   "version": 1,
   "versionNonce": 51810463,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "Asked about tools like this one, Grinding\nGear Games answers that it can't comment on\ntheir legality, doesn't encourage creating or\nusing them, and can't guarantee that a tool\nis allowed or will remain allowed (its forum,\nFebruary 2024).",
   "originalText": "Asked about tools like this one, Grinding\nGear Games answers that it can't comment on\ntheir legality, doesn't encourage creating or\nusing them, and can't guarantee that a tool\nis allowed or will remain allowed (its forum,\nFebruary 2024).",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-77",
   "type": "text",
   "x": 20,
   "y": 2629.5,
   "width": 338.8,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-73"
   ],
   "frameId": "v4-frame-4",
   "roundness": null,
   "seed": 2082899072,
   "version": 1,
   "versionNonce": 783156688,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "In practice, many players have used tools of\nthis kind for years. That is an observation,\nnot a permission: it can change at any time.",
   "originalText": "In practice, many players have used tools of\nthis kind for years. That is an observation,\nnot a permission: it can change at any time.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-78",
   "type": "text",
   "x": 20,
   "y": 2688.0,
   "width": 338.8,
   "height": 122.5,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-73"
   ],
   "frameId": "v4-frame-4",
   "roundness": null,
   "seed": 1128488134,
   "version": 1,
   "versionNonce": 1210883261,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "Grinding Gear Games doesn't endorse or\nguarantee any third-party tool: using it is\nat your own risk. Exile Market is free and\ncomes with no warranty, as its license\nstates. To the extent the law allows, Sylent\nisn't liable for what may happen to your\naccount.",
   "originalText": "Grinding Gear Games doesn't endorse or\nguarantee any third-party tool: using it is\nat your own risk. Exile Market is free and\ncomes with no warranty, as its license\nstates. To the extent the law allows, Sylent\nisn't liable for what may happen to your\naccount.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-80",
   "type": "text",
   "x": 20,
   "y": 2826.5,
   "width": 316.8,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-79"
   ],
   "frameId": "v4-frame-4",
   "roundness": null,
   "seed": 17581914,
   "version": 1,
   "versionNonce": 625675343,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "4. Why must the game run in windowed\nfullscreen?",
   "originalText": "4. Why must the game run in windowed\nfullscreen?",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-81",
   "type": "text",
   "x": 20,
   "y": 2871.5,
   "width": 346.5,
   "height": 70.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-79"
   ],
   "frameId": "v4-frame-4",
   "roundness": null,
   "seed": 1799361520,
   "version": 1,
   "versionNonce": 1585932014,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "Windowed fullscreen or a window both work. In\nexclusive fullscreen, the game lets no\napplication copy the item or show its price\nover it.",
   "originalText": "Windowed fullscreen or a window both work. In\nexclusive fullscreen, the game lets no\napplication copy the item or show its price\nover it.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-83",
   "type": "text",
