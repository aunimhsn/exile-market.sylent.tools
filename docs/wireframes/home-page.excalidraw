   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "– Ctrl + D sends the game the Ctrl + C of one\ncopy, once per press. It doesn't modify the\ngame nor read its memory.",
   "originalText": "– Ctrl + D sends the game the Ctrl + C of one\ncopy, once per press. It doesn't modify the\ngame nor read its memory.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
