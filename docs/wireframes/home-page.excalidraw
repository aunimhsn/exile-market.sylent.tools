   "text": "What it does on your\ncomputer",
   "originalText": "What it does on your\ncomputer",
   "fontSize": 26,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-158",
   "type": "text",
   "x": 540,
   "y": 1355.5,
   "width": 330.0,
   "height": 56.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-156"
   ],
   "frameId": "v4-frame-97",
   "roundness": null,
   "seed": 649187325,
   "version": 1,
   "versionNonce": 1998679711,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "– It watches the clipboard while it runs\nand keeps only what looks like a Path of\nExile 2 item.",
   "originalText": "– It watches the clipboard while it runs\nand keeps only what looks like a Path of\nExile 2 item.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-159",
   "type": "text",
   "x": 540,
   "y": 1419.75,
   "width": 338.25,
   "height": 56.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-156"
   ],
   "frameId": "v4-frame-97",
   "roundness": null,
   "seed": 627813882,
   "version": 1,
   "versionNonce": 2037347502,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "– Ctrl + D sends the game the Ctrl + C of\none copy, once per press. It doesn't\nmodify the game nor read its memory.",
   "originalText": "– Ctrl + D sends the game the Ctrl + C of\none copy, once per press. It doesn't\nmodify the game nor read its memory.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-160",
   "type": "text",
   "x": 540,
   "y": 1484.0,
   "width": 313.5,
   "height": 56.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-156"
   ],
   "frameId": "v4-frame-97",
   "roundness": null,
   "seed": 1504988819,
   "version": 1,
   "versionNonce": 669638768,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "– It connects only to poe2scout, the\ntrade site and GitHub. A search on the\ntrade site runs only when you click.",
   "originalText": "– It connects only to poe2scout, the\ntrade site and GitHub. A search on the\ntrade site runs only when you click.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-162",
   "type": "text",
   "x": 940,
   "y": 1278.5,
   "width": 128.70000000000002,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
