   "x": 20,
   "y": 3002.5,
   "width": 323.40000000000003,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
