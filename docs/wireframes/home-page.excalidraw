   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "– It connects only to poe2scout, the trade\nsite and GitHub. A search on the trade site\nruns only when you click.",
   "originalText": "– It connects only to poe2scout, the trade\nsite and GitHub. A search on the trade site\nruns only when you click.",
