   "link": null,
   "locked": false,
   "text": "Questions",
   "originalText": "Questions",
   "fontSize": 26,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-164",
   "type": "text",
   "x": 940,
   "y": 1323.0,
   "width": 138.60000000000002,
   "height": 22.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-163"
   ],
   "frameId": "v4-frame-97",
   "roundness": null,
   "seed": 61172930,
   "version": 1,
   "versionNonce": 441402618,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "1. Is it free?",
   "originalText": "1. Is it free?",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-165",
   "type": "text",
   "x": 940,
   "y": 1350.5,
   "width": 709.5000000000001,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-163"
   ],
   "frameId": "v4-frame-97",
   "roundness": null,
   "seed": 598077321,
   "version": 1,
   "versionNonce": 1863197322,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "Yes, and it asks for no account. Its code is open, and each release is built in public\nby GitHub Actions, with the checksums of each file.",
   "originalText": "Yes, and it asks for no account. Its code is open, and each release is built in public\nby GitHub Actions, with the checksums of each file.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-167",
   "type": "text",
   "x": 940,
   "y": 1406.0,
   "width": 336.6,
   "height": 22.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-166"
   ],
   "frameId": "v4-frame-97",
   "roundness": null,
   "seed": 836682997,
   "version": 1,
   "versionNonce": 906419965,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "2. Why does Windows show an alert?",
   "originalText": "2. Why does Windows show an alert?",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-168",
   "type": "text",
   "x": 940,
   "y": 1433.5,
   "width": 717.7500000000001,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-166"
   ],
   "frameId": "v4-frame-97",
   "roundness": null,
   "seed": 120232147,
   "version": 1,
   "versionNonce": 1081622283,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "It isn't signed for now. [How to go through the alert: written after the Windows test.]",
   "originalText": "It isn't signed for now. [How to go through the alert: written after the Windows test.]",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-170",
   "type": "text",
   "x": 940,
   "y": 1470.25,
   "width": 287.1,
   "height": 22.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-169"
   ],
   "frameId": "v4-frame-97",
   "roundness": null,
   "seed": 913882254,
   "version": 1,
   "versionNonce": 1258282194,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "3. Can my account be at risk?",
   "originalText": "3. Can my account be at risk?",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-171",
   "type": "text",
   "x": 940,
   "y": 1497.75,
   "width": 701.25,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-169"
   ],
   "frameId": "v4-frame-97",
   "roundness": null,
   "seed": 1033108813,
   "version": 1,
   "versionNonce": 1400113411,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "Exile Market looks up offers on the official trade site through an interface Grinding\nGear Games doesn't document. Their developer documentation says that working out such\nan interface goes against their terms of use (section 7i), and those terms allow them\nto close an account without notice.",
   "originalText": "Exile Market looks up offers on the official trade site through an interface Grinding\nGear Games doesn't document. Their developer documentation says that working out such\nan interface goes against their terms of use (section 7i), and those terms allow them\nto close an account without notice.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-172",
   "type": "text",
   "x": 940,
   "y": 1578.75,
   "width": 701.25,
   "height": 56.25,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-169"
   ],
   "frameId": "v4-frame-97",
   "roundness": null,
   "seed": 1113963314,
   "version": 1,
   "versionNonce": 1799645191,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "Asked about tools like this one, Grinding Gear Games answers that it can't comment on\ntheir legality, doesn't encourage creating or using them, and can't guarantee that a\ntool is allowed or will remain allowed (its forum, February 2024).",
   "originalText": "Asked about tools like this one, Grinding Gear Games answers that it can't comment on\ntheir legality, doesn't encourage creating or using them, and can't guarantee that a\ntool is allowed or will remain allowed (its forum, February 2024).",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-173",
   "type": "text",
   "x": 940,
   "y": 1641.0,
   "width": 627.0,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-169"
   ],
   "frameId": "v4-frame-97",
   "roundness": null,
   "seed": 562957180,
   "version": 1,
   "versionNonce": 261582917,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "In practice, many players have used tools of this kind for years. That is an\nobservation, not a permission: it can change at any time.",
   "originalText": "In practice, many players have used tools of this kind for years. That is an\nobservation, not a permission: it can change at any time.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-174",
   "type": "text",
   "x": 940,
   "y": 1684.5,
   "width": 709.5000000000001,
   "height": 56.25,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-169"
   ],
   "frameId": "v4-frame-97",
   "roundness": null,
   "seed": 1519490801,
   "version": 1,
   "versionNonce": 1967786446,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "Grinding Gear Games doesn't endorse or guarantee any third-party tool: using it is at\nyour own risk. Exile Market is free and comes with no warranty, as its license states.\nTo the extent the law allows, Sylent isn't liable for what may happen to your account.",
   "originalText": "Grinding Gear Games doesn't endorse or guarantee any third-party tool: using it is at\nyour own risk. Exile Market is free and comes with no warranty, as its license states.\nTo the extent the law allows, Sylent isn't liable for what may happen to your account.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v4-text-176",
   "type": "text",
   "x": 940,
   "y": 1758.75,
   "width": 475.20000000000005,
   "height": 22.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v4-group-175"
   ],
   "frameId": "v4-frame-97",
   "roundness": null,
   "seed": 1806584668,
   "version": 1,
   "versionNonce": 561623934,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
